# Runtime (Vercel / serverless): pooled PostgreSQL connection string
# Neon: host with "-pooler" | Supabase: port 6543 transaction pooler
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Migrations & seed (local / CI): direct connection — preferred for prisma migrate / seed
# Omit if your DATABASE_URL is already a direct (non-pooled) URL
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@phonefarm.icu"
ADMIN_PASSWORD="change-me"

# Optional: Telegram notification for new hardware inquiries
INQUIRY_NOTIFY_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
