# PostgreSQL — Neon, Supabase, Vercel Postgres, or local Postgres
# Neon pooled (Vercel/serverless): use the "-pooler" host in the connection string
DATABASE_URL="postgresql://user:password@localhost:5432/phonefarm?schema=public"

JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@phonefarm.icu"
ADMIN_PASSWORD="change-me"

# Optional: Telegram notification for new hardware inquiries
INQUIRY_NOTIFY_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
